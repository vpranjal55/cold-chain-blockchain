# Hardhat local node
RPC_URL=http://127.0.0.1:8545

# Address printed by:
#   npx hardhat run scripts/deploy.js --network localhost
# This is the ONLY place the contract address comes from — app2.py does not
# read deployment.json or any other file for it.
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Private keys of the Hardhat demo accounts used by deploy.js:
#   signers[3] -> authorizedOracle  (backend account: recordTemperature, completeShipment)
#   signers[1] -> shipper           (signs as shipper, activates, starts tracking)
#   signers[2] -> transporter       (signs as transporter)
# Copy these from the account list `npx hardhat node` prints on startup.
# These are local Hardhat TEST keys only — never reuse them on a real network,
# and never commit a real .env with real keys to source control.
ORACLE_PRIVATE_KEY=0xYourOracleAccountPrivateKey
SHIPPER_PRIVATE_KEY=0xYourShipperAccountPrivateKey
TRANSPORTER_PRIVATE_KEY=0xYourTransporterAccountPrivateKey
